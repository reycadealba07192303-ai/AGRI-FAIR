<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks plain http. The dev backend runs on http://10.0.2.2:8080
  (emulator) or the machine's LAN IP, so those hosts are opened up and nothing
  else is. Delete this file once the backend is on HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Palitan ng LAN IP ng laptop mo kapag totoong cellphone ang gamit -->
        <domain includeSubdomains="true">192.168.0.0</domain>
    </domain-config>
</network-security-config>
