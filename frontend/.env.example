# AgriFair frontend — copy to `.env` and fill in as needed.
#
# Backend API base URL (must end with /api).
# Local:  http://localhost:8080/api
# Railway: https://agri-fair-production.up.railway.app/api
VITE_API_URL=http://localhost:8080/api
#
# Direct link to the Android APK or Play Store listing shown on the landing
# page QR / Download button. Leave empty to fall back to this site's #download.
VITE_APP_DOWNLOAD_URL=
