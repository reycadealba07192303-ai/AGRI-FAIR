# AgriFair frontend — copy to `.env` and fill in as needed.
#
# Direct link to the Android APK (Google Drive / Play Store).
# Defaults to the shared AgriFair APK if left empty.
VITE_APP_DOWNLOAD_URL=https://drive.google.com/file/d/103PzpjBsiWU0bW8iLgqojdNuYaMCk6bQ/view?usp=sharing
#
# Backend API base URL (must end with /api).
# Local:  http://localhost:8080/api
# Railway: https://agri-fair-production.up.railway.app/api
VITE_API_URL=http://localhost:8080/api

